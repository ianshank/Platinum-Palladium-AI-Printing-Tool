# Platinum-Palladium AI Printing Tool - Environment Configuration
# Copy this file to .env and configure with your settings

# ============================================================================
# API Configuration
# ============================================================================

# Port for the API server (default: 8000)
PTPD_API_PORT=8000

# API host (0.0.0.0 for Docker, 127.0.0.1 for local)
PTPD_API_HOST=0.0.0.0

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
PTPD_LOG_LEVEL=INFO

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM provider: anthropic or openai
PTPD_LLM_PROVIDER=anthropic

# Anthropic Claude API Key
# Get your key at: https://console.anthropic.com/
PTPD_LLM_ANTHROPIC_API_KEY=

# OpenAI API Key (optional, for GPT models)
# Get your key at: https://platform.openai.com/api-keys
PTPD_LLM_OPENAI_API_KEY=

# Model selection (optional, uses provider defaults if not set)
# PTPD_LLM_MODEL=claude-3-5-sonnet-20241022
# PTPD_LLM_MODEL=gpt-4-turbo-preview

# ============================================================================
# Data Storage
# ============================================================================

# Data directory for profiles, calibrations, and logs
# Docker default: /app/data (internal volume)
# Local default: ./data
PTPD_DATA_DIR=/app/data

# ============================================================================
# Frontend Configuration (Development)
# ============================================================================

# Vite dev server port
VITE_PORT=5173

# API URL for frontend (Docker: http://api:8000, Local: http://localhost:8000)
VITE_API_URL=http://api:8000

# WebSocket URL for real-time updates
VITE_WS_URL=ws://api:8000/ws

# Enable React Query DevTools and Zustand DevTools
VITE_ENABLE_DEVTOOLS=true

# Frontend log level: debug, info, warn, error
VITE_LOG_LEVEL=debug

# ============================================================================
# Optional: GCP Configuration (for cloud storage)
# ============================================================================

# Uncomment if using Google Cloud Platform features
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# PTPD_GCP_PROJECT_ID=your-project-id
# PTPD_GCP_BUCKET_NAME=your-bucket-name

# ============================================================================
# Optional: Redis Configuration (for task queue)
# ============================================================================

# Uncomment if using Celery task queue
# PTPD_REDIS_URL=redis://localhost:6379/0
# PTPD_CELERY_BROKER_URL=redis://localhost:6379/0
# PTPD_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# Docker-Specific Settings
# ============================================================================

# Compose project name (optional)
# COMPOSE_PROJECT_NAME=ptpd-printing-tool

# Docker resource limits (optional)
# DOCKER_API_MEMORY_LIMIT=4g
# DOCKER_API_CPU_LIMIT=2.0
